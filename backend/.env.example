# Copy to .env and adjust as needed. All values have working defaults.
DATABASE_URL=sqlite:///./screener.db
# Production example (Postgres): DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db
ARTIFACTS_DIR=./artifacts
DATA_PROVIDER=yfinance
CORS_ORIGINS=http://localhost:5173
YF_BATCH_SIZE=100
BACKFILL_YEARS=5
PREDICTION_HORIZON_DAYS=21
# Single-service deploy: serve the built frontend from FastAPI. Leave empty for API-only.
# STATIC_DIR=../frontend/dist
